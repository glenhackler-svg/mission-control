generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One row per agent your OpenClaw stack runs. Agents self-report here
/// via POST /api/agents/state. The dashboard reads from this table.
model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt
}

/// A multi-step goal assigned across one or more agents.
/// Glen creates missions from the dashboard; agents execute steps and report back.
model Mission {
  id          String        @id @default(uuid())
  title       String
  description String
  status      String        @default("pending")   // pending | active | completed | failed | cancelled
  priority    String        @default("medium")     // low | medium | high | urgent
  agentId     String        // owner/creator agent (usually "claw")
  currentStep Int           @default(0)
  result      String?
  createdAt   DateTime      @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  steps       MissionStep[]

  @@index([status])
  @@index([agentId])
}

/// A single step within a Mission. Steps execute sequentially.
/// Each step is assigned to a specific agent with a description/prompt.
model MissionStep {
  id          String    @id @default(uuid())
  missionId   String
  mission     Mission   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  stepNumber  Int
  title       String
  description String    // Full prompt/instructions for the agent
  agentId     String    // Which agent runs this step
  status      String    @default("pending")   // pending | active | completed | failed | skipped
  result      String?
  errorDetail String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([missionId])
  @@index([status])
}

/// Ideas your agents generate for you to review.
model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  source      String?
  status      String?  @default("pending")
  timestamp   DateTime @default(now())
  sortOrder   Int      @default(0)

  @@index([category])
  @@index([status])
}

/// Delegation records — when Claw spawns a subagent task, both sides report costs here.
/// Enables full task cost rollup: parent planning tokens + child execution tokens.
model TaskDelegation {
  id                String   @id @default(uuid())
  title             String
  parentAgentId     String   // e.g. "claw"
  childAgentId      String   // e.g. "kodee"
  parentSessionCost Float    @default(0)
  childSessionCost  Float    @default(0)
  totalCost         Float    @default(0)  // maintained as parent + child
  status            String   @default("in_progress") // in_progress | completed | failed
  notes             String?
  delegatedAt       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([parentAgentId])
  @@index([childAgentId])
  @@map("task_delegations")
}

/// Monthly agent cost snapshot — one row per year+month.
/// Written by the end-of-month cron job; used for the annual tally on the agents dashboard.
model MonthlyAgentCost {
  id              String   @id @default(uuid())
  year            Int
  month           Int      // 1–12
  agentCost       Float    @default(0)
  delegationCost  Float    @default(0)
  totalCost       Float    @default(0)
  snapshotAt      DateTime @default(now())

  @@unique([year, month])
  @@map("monthly_agent_costs")
}

/// Generic key-value store for agent-specific config and scratch data.
/// Use this when you need to persist something simple without adding a model.
model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// Task management — projects grouping tasks by client/personal
model Project {
  id         Int             @id @default(autoincrement())
  name       String
  color      String?
  clientName String?         @map("client_name")
  notes      String?
  archived   Boolean         @default(false)
  asanaGid   String?         @map("asana_gid")
  sortOrder  Int             @default(0) @map("sort_order")
  createdAt  DateTime        @default(now()) @map("created_at")
  clients    ClientProject[]
  tasks      Task[]

  @@map("projects")
}

/// Client portal users — each gets a password and sees only tasks
model Client {
  id           String          @id @default(cuid())
  name         String
  email        String?
  passwordHash String
  slug         String          @unique
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  projects     ClientProject[]
  tasks        Task[]
}

/// Join table linking clients to the projects they can see
model ClientProject {
  clientId  String
  projectId Int
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([clientId, projectId])
  @@map("client_projects")
}

/// Individual tasks within a project
model Task {
  id            Int         @id @default(autoincrement())
  projectId     Int         @map("project_id")
  title         String
  notes         String?
  status        String      @default("todo")
  dueDate       DateTime?   @map("due_date") @db.Date
  assignee      String?
  completedAt   DateTime?   @map("completed_at")
  asanaGid      String?     @map("asana_gid")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  sortOrder     Int         @default(0) @map("sort_order")
  clientId      String?
  clientVisible Boolean     @default(false)
  client        Client?     @relation(fields: [clientId], references: [id])
  project       Project     @relation(fields: [projectId], references: [id])
  timeEntries   TimeEntry[]

  @@index([projectId])
  @@index([status])
  @@map("tasks")
}

/// Lead gen outbound emails tracked by Scout
model Lead {
  id               Int       @id @default(autoincrement())
  batchId          String
  company          String
  contactName      String?
  email            String
  website          String?
  opportunityScore Int       @default(5)
  city             String?
  address          String?
  phone            String?
  subject          String
  sentAt           DateTime
  opened           Boolean   @default(false)
  openedAt         DateTime?
  openTrackingId   String    @unique
  unsubscribed     Boolean   @default(false)
  unsubscribedAt   DateTime?
  booked           Boolean   @default(false)
  bookedAt         DateTime?
  bounced          Boolean   @default(false)
  bouncedAt        DateTime?
  notes            String?
  createdAt        DateTime  @default(now())

  @@index([batchId])
  @@index([openTrackingId])
  @@map("leads")
}

/// Time tracking entries per task
model TimeEntry {
  id              Int       @id @default(autoincrement())
  taskId          Int       @map("task_id")
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?      @map("duration_seconds")
  note            String?
  createdAt       DateTime  @default(now()) @map("created_at")
  task            Task      @relation(fields: [taskId], references: [id])

  @@index([taskId])
  @@map("time_entries")
}
